# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables instead.

# Required: your Anthropic API key (console.anthropic.com -> API Keys).
# This is billed separately from any Claude.ai subscription -- add billing
# in the Anthropic Console before this goes live, since you are covering
# every visitor's grading calls centrally.
ANTHROPIC_API_KEY=sk-ant-...

# Which Claude model to grade with. Any current Claude model with vision
# support works; check console.anthropic.com/docs/models for the latest ID.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Required for rate limiting: add the "Upstash Redis" integration from the
# Vercel Marketplace to your project and these two get filled in for you
# automatically. For local dev, create a free database at upstash.com and
# paste its REST URL/token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cost/abuse controls. Tune these to whatever daily spend you're comfortable
# with -- see the "Estimating your cost ceiling" section in README.md.
MAX_GRADINGS_PER_DAY_GLOBAL=200
MAX_GRADINGS_PER_DAY_PER_VISITOR=5
